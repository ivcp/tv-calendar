{% macro button(url, label) %}
<table
  role="presentation"
  cellpadding="0"
  cellspacing="0"
  border="0"
  style="margin:8px 0 24px;mso-table-lspace:0pt;mso-table-rspace:0pt;"
>
  <tr>
    <td
      align="center"
      bgcolor="#2f7d4f"
      style="background-color:#2f7d4f;border-radius:8px;padding:12px 24px;mso-padding-alt:12px 24px;"
    >
      <a
        href="{{ url }}"
        style="display:inline-block;font-family:'Rubik',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;line-height:20px;color:#ffffff;text-decoration:none;"
        >{{ label }}</a
      >
    </td>
  </tr>
</table>
{% endmacro %}
