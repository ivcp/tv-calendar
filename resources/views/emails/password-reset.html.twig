{% extends 'emails/layout.html.twig' %}
{% import 'emails/_button.html.twig' as ui %}

{% block title %}Reset your password | {{ appName }}{% endblock %}

{% block preheader %}Reset the password for your {{ appName }} account.{% endblock %}

{% block content %}
<h1
  style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:700;color:#26303c;"
>
  Reset your password
</h1>
<p style="margin:0 0 16px;">
  We received a request to reset the password for your {{ appName }} account.
  Choose a new password below.
</p>
{{ ui.button(resetLink, 'Reset password') }}
<p style="margin:0;font-size:14px;line-height:1.5;color:#64748b;">
  This link expires in 30 minutes. If you didn't request this, you can ignore
  this email, your password won't change.
</p>
{% endblock %}
