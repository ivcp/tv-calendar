{% extends 'emails/layout.html.twig' %}
{% import 'emails/_button.html.twig' as ui %}

{% block title %}Confirm your email address | {{ appName }}{% endblock %}

{% block preheader %}Confirm your email address to activate your {{ appName }} account.{% endblock %}

{% block content %}
<h1
  style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:700;color:#26303c;"
>
  Confirm your email address
</h1>
<p style="margin:0 0 16px;">
  Thanks for signing up for {{ appName }}. Confirm your email address to
  activate your account and start tracking your shows.
</p>
<p style="margin:0 0 16px;">
  One thing to know: accounts that stay unverified are deleted after 5 days, so
  confirm whenever you get a chance and your account is yours to keep.
</p>
{{ ui.button(activationLink, 'Activate my account') }}
<p style="margin:0;font-size:14px;line-height:1.5;color:#64748b;">
  This link is valid for 48 hours. If it expires, you can request a new one from
  your profile. If you didn't create an account, you can safely ignore this
  email.
</p>
{% endblock %}
