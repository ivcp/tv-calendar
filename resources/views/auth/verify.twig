{% extends 'layout.twig' %}
{% set status = status|default('invalid') %}
{% set page_title = status == 'verified' ? 'Account verified |' : 'Verification failed |' %}

{% block content %}
<section class="mt-16 mb-16 mx-4 flex justify-center">
  <div
    class="card surface bg-base-200 w-full max-w-md p-6 lg:p-8 flex flex-col items-center gap-5 text-center"
  >
    {% if status == 'verified' %}
    <div
      class="flex size-16 items-center justify-center rounded-full bg-success/15 text-success"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-9"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
        />
      </svg>
    </div>
    {% else %}
    <div
      class="flex size-16 items-center justify-center rounded-full bg-error/15 text-error"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-9"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"
        />
      </svg>
    </div>
    {% endif %}

    <div class="space-y-2">
      <h1 class="text-xl font-semibold tracking-tight">
        {% if status == 'verified' %}
        Your account has been verified
        {% elseif status == 'missing' %}
        This account no longer exists
        {% else %}
        Account verification failed
        {% endif %}
      </h1>
      <p class="text-sm text-base-content/70">
        {% if status == 'verified' %}
        Your email address is confirmed. You're all set to keep tracking your
        shows.
        {% elseif status == 'missing' %}
        This account no longer exists. It may have been deleted because it
        wasn't verified in time. You're welcome to create a new one.
        {% elseif user %}
        This verification link is invalid or has expired. Request a new link
        from your profile. Unverified accounts are deleted after 5 days.
        {% else %}
        This verification link is invalid or has expired. Log in and request a
        new link from your profile. Unverified accounts are deleted after 5
        days.
        {% endif %}
      </p>
    </div>

    <div class="flex w-full flex-col gap-2 sm:flex-row sm:justify-center">
      {% if status == 'verified' %}
      <a href="/" class="btn btn-primary">Go to calendar</a>
      {% if user %}
      <a href="/profile" class="btn btn-ghost">Manage notifications</a>
      {% else %}
      <a href="/login" class="btn btn-ghost">Log in</a>
      {% endif %}
      {% elseif status == 'missing' %}
      <a href="/register" class="btn btn-primary">Create a new account</a>
      <a href="/" class="btn btn-ghost">Back to calendar</a>
      {% else %}
      {% if user %}
      <a href="/profile" class="btn btn-primary">Go to profile</a>
      {% else %}
      <a href="/login" class="btn btn-primary">Log in</a>
      {% endif %}
      <a href="/" class="btn btn-ghost">Back to calendar</a>
      {% endif %}
    </div>
  </div>
</section>
{% endblock %}
