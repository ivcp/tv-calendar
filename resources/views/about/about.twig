{% extends 'layout.twig' %}
{% set page_title = 'About |' %}

{% set page_meta_desc = 'Learn how TvShowCalendar makes it easy to track the shows you love. Create a free watchlist, view upcoming episodes, and set up release notifications.' %}
{% set page_canonical = app_url ~ current_url() %}

{% block content %}

<section
  class="mt-16 mb-16 flex flex-col gap-8 lg:gap-10 mx-4 lg:items-center lg:mx-0"
>
  <div class="flex flex-col items-center gap-2 text-center">
    <h1 class="font-semibold tracking-tight text-xl">About {{ app_name }}</h1>
    <p class="text-base-content/70 max-w-3xl">
      Track the shows you follow, see what's airing next, and get notified
      before you miss an episode.
    </p>
    <div class="flex flex-wrap justify-center gap-2 mt-2">
      <a href="/" class="btn btn-primary">Open the calendar</a>
      <a href="/register" class="btn btn-outline">Create a free account</a>
    </div>
  </div>

  <div class="w-full max-w-3xl text-lg space-y-8">
    <div class="grid gap-4 lg:grid-cols-2">
      <a
        href="/showlist"
        class="card surface bg-base-200 p-6 gap-2 hover:bg-base-300 transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"
          />
        </svg>
        <p class="font-bold">Watchlist</p>
        <p class="text-sm text-base-content/70">
          Keep a personal list of the shows you follow.
        </p>
      </a>

      <a
        href="/"
        class="card surface bg-base-200 p-6 gap-2 hover:bg-base-300 transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z"
          />
        </svg>
        <p class="font-bold">Calendar</p>
        <p class="text-sm text-base-content/70">
          See upcoming episodes at a glance.
        </p>
      </a>

      <a
        href="/discover"
        class="card surface bg-base-200 p-6 gap-2 hover:bg-base-300 transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 20.25h12m-7.5-3v3m3-3v3m-10.125-3h17.25c.621 0 1.125-.504 1.125-1.125V4.875c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125Z"
          />
        </svg>
        <p class="font-bold">Discover</p>
        <p class="text-sm text-base-content/70">
          Find new shows to add to your list.
        </p>
      </a>

      <a
        href="/get-notified"
        class="card surface bg-base-200 p-6 gap-2 hover:bg-base-300 transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"
          />
        </svg>
        <p class="font-bold">Notifications</p>
        <p class="text-sm text-base-content/70">
          Get alerts on your phone or via Discord.
        </p>
      </a>
    </div>

    <div class="space-y-4">
      <h2 class="text-xl font-bold">Free, with or without an account</h2>
      <p class="text-base-content/70">
        Tracking your favorite shows is completely free.
      </p>
      <div class="grid gap-4 lg:grid-cols-2">
        <div class="card surface bg-base-200 p-6 text-sm space-y-2">
          <p class="font-bold">No account needed</p>
          <p class="text-base-content/70">
            Your watchlist is saved right in your browser, with room for up to
            10 shows. Perfect for casual TV fans.
          </p>
        </div>
        <div class="card surface bg-base-200 p-6 text-sm space-y-2">
          <p class="font-bold">Free account</p>
          <p class="text-base-content/70">
            Removes the limit, stores your shows safely on our servers, and lets
            you access your list from any device. You can also opt in to receive
            notifications on your phone or via Discord.
          </p>
          <a href="/register" class="link font-bold">Create one</a>
        </div>
      </div>
    </div>

    <div
      class="card surface bg-base-200 p-6 flex flex-col items-center gap-3 text-center"
    >
      <p class="font-bold text-xl">Ready to stop missing episodes?</p>
      <a href="/register" class="btn btn-primary">Create a free account</a>
    </div>
  </div>
</section>
{% endblock %}
