<article class="flex flex-col items-center lg:h-80 group">
  <a
    class="card bg-base-100 image-full w-max rounded-lg before:hidden"
    href="/shows/{{ show.id }}-{{show.slug}}"
  >
    <figure
      class="w-[210px] h-[295px] rounded-lg {{ show.imageMedium ? 'skeleton' : '' }}"
    >
      {% if show.imageMedium %}
      <img
        src="{{ show.imageMedium }}"
        alt="{{ show.name }}"
        loading="lazy"
        decoding="async"
        onload="this.classList.add('bg-base-200')"
        class="rounded-lg"
      />
      {% else %}
      <div
        class="flex h-full w-full flex-col items-center justify-center gap-2 rounded-lg bg-gradient-to-br from-base-200 to-base-300 px-4 text-center ring-1 ring-base-300"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-10 text-base-content/30"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
          />
        </svg>
        <p class="text-sm text-base-content/50">No poster available</p>
      </div>
      {% endif %}
    </figure>
    {% if current_url() is same as('/discover') %} {% include
    'components/add-remove-btn.twig' with {'show': show, 'userShows': userShows }%}
    {% else %} {% include 'components/remove-show-btn.twig' with {'show': show } %}
    {% endif %}
  </a>
  <p
    class="mt-1 text-center font-bold break-words max-w-[22ch] max-h-12 text-ellipsis overflow-clip"
  >
    {{ show.name }}
  </p>
</article>
